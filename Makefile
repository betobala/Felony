RACK_DIR ?= ../../tools/Rack-SDK

# the O&C firmware (src/oc, generated by tools/port.py) plus the virtual hardware (shim)
FLAGS += -Ishim -Isrc/oc -fpermissive -Wno-everything -w -DF_CPU=120000000

SOURCES += src/Felony.cpp src/OcRunner.cpp src/oc_firmware.cpp shim/arduino.cpp
SOURCES += $(shell find src/oc -name '*.cpp')

DISTRIBUTABLES += res
DISTRIBUTABLES += $(wildcard LICENSE*)

include $(RACK_DIR)/plugin.mk

CXXFLAGS += -std=gnu++14
